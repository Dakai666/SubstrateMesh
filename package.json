    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dakai666/SubstrateMesh.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Dakai666/SubstrateMesh/issues"
  },
  "homepage": "https://github.com/Dakai666/SubstrateMesh#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "bin": {
    "substrate": "dist/cli.js"
  },
